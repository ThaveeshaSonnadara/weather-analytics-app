{
  "name": "weather-analytics-angular-fe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/weather-analytics-angular-fe/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/weather-analytics-angular-fe",
        "browser": "apps/weather-analytics-angular-fe/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/weather-analytics-angular-fe/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/weather-analytics-angular-fe/public"
          }
        ],
        "styles": ["apps/weather-analytics-angular-fe/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/weather-analytics-angular-fe/src/environments/environment.ts",
              "with": "apps/weather-analytics-angular-fe/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "weather-analytics-angular-fe:build:production",
          "fileReplacements": [
            {
              "replace": "apps/weather-analytics-angular-fe/src/environments/environment.ts",
              "with": "apps/weather-analytics-angular-fe/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "buildTarget": "weather-analytics-angular-fe:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "options": {
        "command": "vitest run",
        "cwd": "apps/weather-analytics-angular-fe",
        "parallel": false,
        "watch": false,
        "env": {
          "VITE_CONFIG_NATIVE_IGNORE_WARNING": "true"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "weather-analytics-angular-fe:build",
        "port": 4200,
        "staticFilePath": "dist/apps/weather-analytics-angular-fe/browser",
        "spa": true
      }
    }
  }
}
